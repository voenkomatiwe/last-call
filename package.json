{
  "name": "last-call",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "bun run --filter @last-call/web dev",
    "build": "bun run --filter @last-call/web build",
    "start": "bun run --filter @last-call/web start",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "typecheck": "bun run --filter @last-call/web typecheck && bun run typecheck:tasks",
    "test": "bun test",
    "check": "bun run biome:check && bun run typecheck && bun run test",
    "prepare": "husky",
    "typecheck:tasks": "test ! -f docs/tasks/tasks.ts || bun check docs/tasks/tasks.ts docs/tasks/tasks.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  }
}
