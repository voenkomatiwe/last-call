# Copy to web/.env.local. These values are public: Next.js inlines NEXT_PUBLIC_ variables into browser code.

# testnet (default) or mainnet
NEXT_PUBLIC_NEAR_NETWORK=testnet

# Account of the deployed Last Call contract. Required.
NEXT_PUBLIC_CONTRACT_ID=

# Optional RPC override. Defaults to https://test.rpc.fastnear.com (testnet) or https://free.rpc.fastnear.com (mainnet).
# Must be https, or http for localhost (sandbox).
# NEXT_PUBLIC_NEAR_RPC_URL=
